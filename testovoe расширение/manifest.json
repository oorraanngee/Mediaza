{
  "manifest_version": 3,
  "name": "Медиаза",
  "version": "2.1.0",
  "description": "Упаковка QVGA-видео со звуком в многокадровый GIF",
  "icons": {
    "16": "favicon.png",
    "32": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Медиаза",
    "default_icon": {
      "16": "favicon.png",
      "32": "favicon.png",
      "48": "favicon.png",
      "128": "favicon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://dragonfly-flash.ru/*",
        "https://*.dragonfly-flash.ru/*",
        "https://dragonfly-flash.com/*",
        "https://*.dragonfly-flash.com/*"
      ],
      "js": ["gif.js", "codec.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}