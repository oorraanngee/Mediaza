{
  "manifest_version": 3,
  "name": "Медиаза",
  "version": "2.2.0",
  "description": "Видео и аудио внутри GIF на Стрекозе: XP-плеер, визуализаторы, плавающий мини-плеер и конвертация форматов.",
  "icons": {
    "16": "favicon.png",
    "32": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "sandbox": {
    "pages": [
      "ffmpeg_sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; child-src 'self' blob:;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Медиаза",
    "default_icon": {
      "16": "favicon.png",
      "32": "favicon.png",
      "48": "favicon.png",
      "128": "favicon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://dragonfly-flash.ru/*",
        "https://*.dragonfly-flash.ru/*",
        "https://dragonfly-flash.com/*",
        "https://*.dragonfly-flash.com/*"
      ],
      "js": ["gif.js", "codec.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}